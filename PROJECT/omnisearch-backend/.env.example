# OmniSearch Backend — Environment Variables
# Copy this file to .env and fill in values for your local setup

# ── Server ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Storage ────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
SQLITE_PATH=./data/omnisearch.db

# ── ChromaDB ───────────────────────────────────────────────────────────────
CHROMA_HOST=http://localhost:8000
CHROMA_COLLECTION_TEXT=text_chunks
CHROMA_COLLECTION_IMAGE=image_metadata
CHROMA_COLLECTION_AUDIO=audio_segments

# ── Ollama (local LLM + Embedding) ─────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
EMBED_MODEL=nomic-embed-text
LLM_MODEL=llama3.1:8b
VISION_MODEL=llava:7b

# ── Whisper.cpp (audio transcription) ──────────────────────────────────────
WHISPER_MODEL=base.en
WHISPER_BIN=/usr/local/bin/whisper

# ── Chunking ───────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Retrieval ──────────────────────────────────────────────────────────────
TOP_K=10
MAX_CONTEXT_TOKENS=4096

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
